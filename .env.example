# Kitapmeetup — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp kendi Supabase projenizin
# bilgilerini girin. Boş bırakırsanız uygulama otomatik olarak
# src/lib/fixtures altındaki örnek verilerle çalışır (bkz. README.md).

# Supabase Proje Ayarları > API sayfasından alınır
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sadece scripts/seed.ts (örnek veri yükleme) için gerekli — asla istemciye göndermeyin.
SUPABASE_SERVICE_ROLE_KEY=

# Canlı alan adınız (sondaki "/" olmadan) — sitemap.xml, robots.txt ve sosyal
# medya paylaşım kartları (Open Graph) için kullanılır. Boş bırakılırsa
# https://kitapmeetup.com varsayılır.
NEXT_PUBLIC_SITE_URL=

# Etkinlik kayıt onay e-postaları (opsiyonel — ikisi de boşsa e-posta
# gönderilmez, uygulama yine çalışır). Kurulum: docs/EMAIL_SETUP.md
# Seçenek 1 — Google Apps Script (ücretsiz, Google'ın kendi altyapısı):
GOOGLE_APPS_SCRIPT_EMAIL_URL=
GOOGLE_APPS_SCRIPT_EMAIL_TOKEN=
# Seçenek 2 — Resend (ücretsiz katmanlı transactional e-posta API'si):
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Instagram'da paylaşım (opsiyonel — boşsa "Instagram'da paylaş" butonları
# yöneticilere "henüz kurulmadı" gösterir, uygulama yine çalışır).
# Kurulum: docs/INSTAGRAM_SETUP.md
META_APP_ID=
META_APP_SECRET=
